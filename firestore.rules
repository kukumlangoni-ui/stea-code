rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// WARNING — MERGE BEFORE DEPLOYING
// This file currently contains ONLY the analytics-events rules added for
// copy/download tracking. The production ruleset lives in Firebase Console.
// Do NOT deploy this file as-is — a partial ruleset default-denies every
// other collection. Merge these match blocks into the existing rules first.
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        (request.auth.token.email_verified == true && request.auth.token.email in ["kukumlangoni@gmail.com", "stea.africa@gmail.com"])
      );
    }

    // User profile documents
    match /users/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow write: if request.auth != null && request.auth.uid == uid;

      // Per-user analytics events (copy / download tracking)
      match /events/{eventId} {
        allow create, read: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Collection-group query on all events subcollections across all users
    match /{path=**}/events/{eventId} {
      allow read: if isAdmin();
    }

    // Anonymous analytics events
    match /anonymous_events/{eventId} {
      allow create: if true;
      allow read: if isAdmin();
    }

  }
}
