rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── HELPERS ──────────────────────────────────────────
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function isSignedIn() { return request.auth != null; }
    
    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isPrimaryAdmin() {
      return isSignedIn() &&
        request.auth.token.email != null &&
        request.auth.token.email == "stea.africa@gmail.com";
    }

    function isSuperAdmin() {
      return isPrimaryAdmin();
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isRole(roles) {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in roles;
    }

    function isEditor() {
      return isSuperAdmin() || isRole(['admin', 'editor', 'manager']);
    }

    function isClassroomTeacher() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('classroomRole', '') == 'teacher';
    }

    function isAlphaUser() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/schools/alpha/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/schools/alpha/users/$(request.auth.uid)).data.schoolId == 'alpha'
        && get(/databases/$(database)/documents/schools/alpha/users/$(request.auth.uid)).data.get('status', 'active') == 'active';
    }

    function alphaRole() {
      return isAlphaUser()
        ? get(/databases/$(database)/documents/schools/alpha/users/$(request.auth.uid)).data.role
        : '';
    }

    function alphaRoles() {
      return isAlphaUser()
        ? get(/databases/$(database)/documents/schools/alpha/users/$(request.auth.uid)).data.get('roles', [alphaRole()])
        : [];
    }

    function isAlphaRole(roles) {
      return isAlphaUser() && (alphaRole() in roles || alphaRoles().hasAny(roles));
    }

    function isAlphaDoc(data) {
      return data.schoolId == 'alpha';
    }

    function isAlphaSchoolAdmin() {
      return isAlphaRole(['schoolAdmin', 'admin']);
    }

    function isAlphaTeacher() {
      return isAlphaRole(['teacher']);
    }

    function isAlphaAssignedTeacher(data) {
      return isAlphaTeacher() && (
        data.get('teacherId', '') == request.auth.uid ||
        data.get('createdBy', '') == request.auth.uid ||
        data.get('ownerId', '') == request.auth.uid ||
        request.auth.uid in data.get('teacherIds', []) ||
        request.auth.uid in data.get('assignedTeacherIds', [])
      );
    }

    function isAlphaTeacherClass(classId) {
      return isAlphaTeacher()
        && classId is string
        && exists(/databases/$(database)/documents/schools/alpha/classes/$(classId))
        && isAlphaAssignedTeacher(get(/databases/$(database)/documents/schools/alpha/classes/$(classId)).data);
    }

    function isAlphaStudentClass(classId) {
      return isAlphaRole(['student'])
        && classId is string
        && (
          classId == get(/databases/$(database)/documents/schools/alpha/users/$(request.auth.uid)).data.get('classId', '') ||
          classId in get(/databases/$(database)/documents/schools/alpha/users/$(request.auth.uid)).data.get('classIds', []) ||
          classId in get(/databases/$(database)/documents/schools/alpha/users/$(request.auth.uid)).data.get('assignedClassIds', [])
        );
    }

    function canReadAlphaLearningDoc(data) {
      return isPrimaryAdmin() ||
        isAlphaSchoolAdmin() ||
        (isAlphaTeacher() && (
          data.get('teacherId', '') == request.auth.uid ||
          data.get('createdBy', '') == request.auth.uid ||
          data.get('ownerId', '') == request.auth.uid
        )) ||
        isAlphaTeacherClass(data.classId) ||
        isAlphaStudentClass(data.classId);
    }

    function canWriteAlphaLearningDoc(data) {
      return isPrimaryAdmin() ||
        (isAlphaDoc(data) && (
          isAlphaSchoolAdmin() ||
          (isAlphaTeacher() && (
            data.get('teacherId', '') == request.auth.uid ||
            data.get('createdBy', '') == request.auth.uid ||
            data.get('ownerId', '') == request.auth.uid
          )) ||
          isAlphaTeacherClass(data.classId)
        ));
    }

    function isAlphaTeacherStudentRosterCreate(userId) {
      return isAlphaTeacher()
        && userId.matches('student-.*')
        && incoming().role == 'student'
        && incoming().schoolId == 'alpha'
        && incoming().status == 'active'
        && incoming().passwordCreated == false
        && incoming().createdBy == request.auth.uid
        && incoming().classId is string
        && incoming().classIds == [incoming().classId]
        && incoming().studentId is string
        && incoming().fullName is string
        && incoming().email is string
        && incoming().email.matches('.*@alpha[.]stea[.]africa')
        && isAlphaTeacherClass(incoming().classId);
    }

    function isAlphaTeacherStudentRosterUpdate(userId) {
      return isAlphaTeacher()
        && userId.matches('student-.*')
        && resource.data.role == 'student'
        && resource.data.schoolId == 'alpha'
        && incoming().role == 'student'
        && incoming().schoolId == 'alpha'
        && incoming().status in ['active', 'deleted', 'replaced']
        && incoming().studentId is string
        && incoming().fullName is string
        && incoming().email is string
        && incoming().email.matches('.*@alpha[.]stea[.]africa')
        && incoming().classId is string
        && incoming().classIds == [incoming().classId]
        && isAlphaTeacherClass(incoming().classId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fullName', 'studentId', 'email', 'phone', 'role', 'schoolId',
          'classId', 'classIds', 'className', 'form', 'stream', 'status',
          'passwordCreated', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy',
          'note', 'uid', 'claimedUid', 'claimedAt', 'attachedAt', 'attachedFrom',
          'deletedAt', 'deletedBy', 'replacedBy'
        ]);
    }

    function isAlphaApprovedEmailAttachment(data) {
      return isSignedIn()
        && request.auth.token.email != null
        && data.uid == request.auth.uid
        && data.email == request.auth.token.email
        && data.schoolId == 'alpha'
        && data.status == 'active'
        && data.role in ['teacher', 'schoolAdmin']
        && exists(/databases/$(database)/documents/schools/alpha/emailAccess/$(request.auth.token.email))
        && get(/databases/$(database)/documents/schools/alpha/emailAccess/$(request.auth.token.email)).data.get('status', 'active') == 'active'
        && get(/databases/$(database)/documents/schools/alpha/emailAccess/$(request.auth.token.email)).data.role in ['teacher', 'schoolAdmin', 'admin'];
    }

    function isAlphaStudentRosterAttachment(data) {
      return isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email.matches('.*@alpha[.]stea[.]africa')
        && data.uid == request.auth.uid
        && data.email == request.auth.token.email
        && data.schoolId == 'alpha'
        && data.role == 'student'
        && data.status == 'active'
        && data.passwordCreated == true
        && data.attachedFrom is string
        && data.attachedFrom.matches('student-.*')
        && exists(/databases/$(database)/documents/schools/alpha/users/$(data.attachedFrom))
        && get(/databases/$(database)/documents/schools/alpha/users/$(data.attachedFrom)).data.role == 'student'
        && get(/databases/$(database)/documents/schools/alpha/users/$(data.attachedFrom)).data.email == request.auth.token.email
        && get(/databases/$(database)/documents/schools/alpha/users/$(data.attachedFrom)).data.get('status', 'active') != 'suspended';
    }

    function isAlphaOwnProfileAttachment(data) {
      return isAlphaApprovedEmailAttachment(data) || isAlphaStudentRosterAttachment(data);
    }

    function keepsProtectedUserFields() {
      return !(
        request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'roles', 'admin', 'isAdmin', 'permissions', 'status'
        ])
      );
    }

    function isReferralAward(userId) {
      return isSignedIn()
        && request.auth.uid != userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'referralCount', 'referralPoints', 'referralBadges', 'points', 'updatedAt'
        ])
        && request.resource.data.referralCount == resource.data.referralCount + 1
        && request.resource.data.referralPoints == resource.data.referralPoints + 50
        && request.resource.data.points == resource.data.points + 50
        && existsAfter(/databases/$(database)/documents/referrals/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/referrals/$(request.auth.uid)).data.referrerId == userId;
    }

    function isReferralSetup(userId) {
      return isSignedIn()
        && request.auth.uid == userId
        && resource.data.get('referralCode', null) == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'referralCode', 'referralCount', 'referralPoints', 'referralBadges', 'updatedAt'
        ])
        && request.resource.data.referralCount == 0
        && request.resource.data.referralPoints == 0
        && request.resource.data.referralBadges == []
        && getAfter(/databases/$(database)/documents/referralCodes/$(request.resource.data.referralCode)).data.ownerId == userId;
    }

    function isReferralAttribution(userId) {
      return isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'referredBy', 'referralCodeUsed', 'updatedAt'
        ])
        && existsAfter(/databases/$(database)/documents/referrals/$(userId))
        && getAfter(/databases/$(database)/documents/referrals/$(userId)).data.inviteeId == userId;
    }

    function isCeo(uid) {
      return isSignedIn() &&
        request.auth.uid == uid &&
        request.auth.token.email != null && 
        request.auth.token.email == "stea.africa@gmail.com";
    }

    // ── PUBLIC COLLECTIONS ───────────────────────────────
    match /schools/{schoolId} {
      allow get: if isPrimaryAdmin() || (schoolId == 'alpha' && isAlphaUser());
      allow list: if isPrimaryAdmin();
      allow create, update: if isPrimaryAdmin() && incoming().schoolId == schoolId;
      allow delete: if isPrimaryAdmin();

      match /users/{userId} {
        allow get: if isPrimaryAdmin() || (schoolId == 'alpha' && (
          isPrimaryAdmin() ||
          request.auth.uid == userId ||
          isAlphaRole(['schoolAdmin', 'teacher']) ||
          (
            isSignedIn()
            && request.auth.token.email != null
            && userId.matches('student-.*')
            && resource.data.role == 'student'
            && resource.data.email == request.auth.token.email
          )
        ));
        allow list: if isPrimaryAdmin() || (schoolId == 'alpha' && (
          isSignedIn() ||
          isAlphaRole(['schoolAdmin', 'teacher'])
        ));
        allow create: if (isPrimaryAdmin() && incoming().schoolId == schoolId) || (schoolId == 'alpha' && isAlphaDoc(incoming()) && (
          isPrimaryAdmin() ||
          isAlphaSchoolAdmin() ||
          isAlphaTeacherStudentRosterCreate(userId) ||
          (request.auth.uid == userId && isAlphaOwnProfileAttachment(incoming())) ||
          (
            request.auth.uid == userId
            && incoming().uid == request.auth.uid
            && incoming().role in ['schoolAdmin', 'teacher', 'student']
            && incoming().status == 'active'
            && (
              (
                incoming().role in ['schoolAdmin', 'teacher']
                && request.auth.token.email != null
                && incoming().email == request.auth.token.email
                && exists(/databases/$(database)/documents/schools/alpha/emailAccess/$(request.auth.token.email))
                && get(/databases/$(database)/documents/schools/alpha/emailAccess/$(request.auth.token.email)).data.get('status', 'active') == 'active'
                && get(/databases/$(database)/documents/schools/alpha/emailAccess/$(request.auth.token.email)).data.role in ['schoolAdmin', 'admin', 'teacher']
              ) ||
              (
                exists(/databases/$(database)/documents/schools/alpha/invitations/$(request.resource.data.get('inviteCode', '')))
                && get(/databases/$(database)/documents/schools/alpha/invitations/$(request.resource.data.get('inviteCode', ''))).data.schoolId == 'alpha'
                && get(/databases/$(database)/documents/schools/alpha/invitations/$(request.resource.data.get('inviteCode', ''))).data.status == 'active'
                && get(/databases/$(database)/documents/schools/alpha/invitations/$(request.resource.data.get('inviteCode', ''))).data.role == incoming().role
              )
            )
          )
        ));
        allow update: if (isPrimaryAdmin() && incoming().schoolId == schoolId) || (schoolId == 'alpha' && isAlphaDoc(incoming()) && (
          isPrimaryAdmin() ||
          isAlphaSchoolAdmin() ||
          isAlphaTeacherStudentRosterUpdate(userId) ||
          (request.auth.uid == userId && isAlphaOwnProfileAttachment(incoming())) ||
          (
            request.auth.uid == userId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'lastLogin', 'attachedAt', 'updatedAt', 'passwordCreated', 'claimedUid',
              'claimedAt', 'uid', 'email', 'role', 'schoolId', 'status', 'fullName',
              'phone', 'attachedFrom', 'studentId', 'classId', 'classIds', 'className',
              'form', 'stream', 'createdBy', 'note', 'mustChangePassword',
              'passwordChangedAt'
            ])
          )
        ));
        allow delete: if isPrimaryAdmin() || (schoolId == 'alpha' && isAlphaSchoolAdmin());
      }

      match /emailAccess/{emailId} {
        allow get: if isPrimaryAdmin() || (schoolId == 'alpha' && (
          isAlphaSchoolAdmin() ||
          (isSignedIn() && request.auth.token.email == emailId)
        ));
        allow list: if isPrimaryAdmin() || (schoolId == 'alpha' && isAlphaSchoolAdmin());
        allow create, update, delete: if isPrimaryAdmin() || (schoolId == 'alpha' && isAlphaSchoolAdmin());
      }

      match /invitations/{inviteId} {
        allow get: if isPrimaryAdmin() || schoolId == 'alpha';
        allow list: if isPrimaryAdmin() || (schoolId == 'alpha' && isAlphaSchoolAdmin());
        allow create, update: if (isPrimaryAdmin() && incoming().schoolId == schoolId) || (
          schoolId == 'alpha'
          && isAlphaDoc(incoming())
          && isAlphaSchoolAdmin()
        );
        allow delete: if isPrimaryAdmin() || (schoolId == 'alpha' && isAlphaSchoolAdmin());
      }

      match /classes/{docId} {
        allow read: if isPrimaryAdmin() || (schoolId == 'alpha' && isAlphaUser());
        allow create: if (isPrimaryAdmin() && incoming().schoolId == schoolId) || (schoolId == 'alpha' && isAlphaDoc(incoming()) && (isAlphaSchoolAdmin() || isAlphaAssignedTeacher(incoming())));
        allow update: if (isPrimaryAdmin() && incoming().schoolId == schoolId) || (schoolId == 'alpha' && isAlphaDoc(incoming()) && (isAlphaSchoolAdmin() || isAlphaAssignedTeacher(resource.data)));
        allow delete: if isPrimaryAdmin() || (schoolId == 'alpha' && isAlphaSchoolAdmin());
      }

      match /subjects/{docId} {
        allow read: if isPrimaryAdmin() || (schoolId == 'alpha' && isAlphaUser());
        allow create: if (isPrimaryAdmin() && incoming().schoolId == schoolId) || (schoolId == 'alpha' && isAlphaDoc(incoming()) && isAlphaSchoolAdmin());
        allow update: if (isPrimaryAdmin() && incoming().schoolId == schoolId) || (schoolId == 'alpha' && isAlphaDoc(incoming()) && isAlphaSchoolAdmin());
        allow delete: if isPrimaryAdmin() || (schoolId == 'alpha' && isAlphaSchoolAdmin());
      }

      match /attendance/{docId} {
        allow read: if isPrimaryAdmin() || (schoolId == 'alpha' && isAlphaUser());
        allow create, update: if (isPrimaryAdmin() && incoming().schoolId == schoolId) || (schoolId == 'alpha' && isAlphaDoc(incoming()) && (isAlphaSchoolAdmin() || isAlphaAssignedTeacher(incoming())));
        allow delete: if isPrimaryAdmin() || (schoolId == 'alpha' && isAlphaSchoolAdmin());
      }

      match /assignments/{docId} {
        allow read: if schoolId == 'alpha' && canReadAlphaLearningDoc(resource.data);
        allow create: if schoolId == 'alpha' && canWriteAlphaLearningDoc(incoming());
        allow update: if schoolId == 'alpha' && canWriteAlphaLearningDoc(incoming()) && canWriteAlphaLearningDoc(resource.data);
        allow delete: if schoolId == 'alpha' && canWriteAlphaLearningDoc(resource.data);
      }

      match /quizzes/{docId} {
        allow read: if schoolId == 'alpha' && canReadAlphaLearningDoc(resource.data);
        allow create: if schoolId == 'alpha' && canWriteAlphaLearningDoc(incoming());
        allow update: if schoolId == 'alpha' && canWriteAlphaLearningDoc(incoming()) && canWriteAlphaLearningDoc(resource.data);
        allow delete: if schoolId == 'alpha' && canWriteAlphaLearningDoc(resource.data);
      }

      match /quizAttempts/{docId} {
        allow read: if isPrimaryAdmin() || (schoolId == 'alpha' && (
          isAlphaSchoolAdmin() ||
          (isAlphaRole(['student']) && resource.data.studentUid == request.auth.uid) ||
          isAlphaTeacherClass(resource.data.classId)
        ));
        allow create: if isPrimaryAdmin() || (schoolId == 'alpha'
          && isAlphaDoc(incoming())
          && isAlphaRole(['student'])
          && incoming().studentUid == request.auth.uid
          && isAlphaStudentClass(incoming().classId)
          && incoming().quizId is string
          && exists(/databases/$(database)/documents/schools/alpha/quizzes/$(incoming().quizId))
          && get(/databases/$(database)/documents/schools/alpha/quizzes/$(incoming().quizId)).data.status == 'published'
          && get(/databases/$(database)/documents/schools/alpha/quizzes/$(incoming().quizId)).data.classId == incoming().classId
        );
        allow update: if isPrimaryAdmin() || (schoolId == 'alpha' && isAlphaDoc(incoming()) && (
          (isAlphaRole(['student']) && resource.data.studentUid == request.auth.uid && incoming().studentUid == request.auth.uid) ||
          isAlphaSchoolAdmin() ||
          isAlphaTeacherClass(resource.data.classId)
        ));
        allow delete: if isPrimaryAdmin() || (schoolId == 'alpha' && isAlphaSchoolAdmin());
      }

      match /notes/{docId} {
        allow read: if schoolId == 'alpha' && canReadAlphaLearningDoc(resource.data);
        allow create: if schoolId == 'alpha' && canWriteAlphaLearningDoc(incoming());
        allow update: if schoolId == 'alpha' && canWriteAlphaLearningDoc(incoming()) && canWriteAlphaLearningDoc(resource.data);
        allow delete: if schoolId == 'alpha' && canWriteAlphaLearningDoc(resource.data);
      }

      match /announcements/{docId} {
        allow read: if isPrimaryAdmin() || (schoolId == 'alpha' && isAlphaUser());
        allow create: if (isPrimaryAdmin() && incoming().schoolId == schoolId) || (schoolId == 'alpha' && isAlphaDoc(incoming()) && (isAlphaSchoolAdmin() || isAlphaAssignedTeacher(incoming())));
        allow update: if (isPrimaryAdmin() && incoming().schoolId == schoolId) || (schoolId == 'alpha' && isAlphaDoc(incoming()) && (isAlphaSchoolAdmin() || isAlphaAssignedTeacher(resource.data)));
        allow delete: if isPrimaryAdmin() || (schoolId == 'alpha' && isAlphaSchoolAdmin());
      }

      match /resources/{docId} {
        allow read: if schoolId == 'alpha' && canReadAlphaLearningDoc(resource.data);
        allow create: if schoolId == 'alpha' && canWriteAlphaLearningDoc(incoming());
        allow update: if schoolId == 'alpha' && canWriteAlphaLearningDoc(incoming()) && canWriteAlphaLearningDoc(resource.data);
        allow delete: if schoolId == 'alpha' && canWriteAlphaLearningDoc(resource.data);
      }

      match /assignmentSubmissions/{docId} {
        allow read: if isPrimaryAdmin() || (schoolId == 'alpha' && (
          isAlphaSchoolAdmin() ||
          isAlphaTeacherClass(resource.data.classId) ||
          (isAlphaRole(['student']) && resource.data.studentUid == request.auth.uid)
        ));
        allow create: if (isPrimaryAdmin() && incoming().schoolId == schoolId) || (
          schoolId == 'alpha'
          && isAlphaDoc(incoming())
          && isAlphaRole(['student'])
          && incoming().studentUid == request.auth.uid
          && isAlphaStudentClass(incoming().classId)
        );
        allow update: if (isPrimaryAdmin() && incoming().schoolId == schoolId) || (schoolId == 'alpha' && isAlphaDoc(incoming()) && (
          isAlphaSchoolAdmin() ||
          isAlphaTeacherClass(resource.data.classId) ||
          (isAlphaRole(['student']) && resource.data.studentUid == request.auth.uid && incoming().studentUid == request.auth.uid && isAlphaStudentClass(resource.data.classId))
        ));
        allow delete: if isPrimaryAdmin() || (schoolId == 'alpha' && isAlphaSchoolAdmin());
      }

      match /terms/{docId} {
        allow read: if isPrimaryAdmin() || (schoolId == 'alpha' && isAlphaUser());
        allow write: if (isPrimaryAdmin() && incoming().schoolId == schoolId) || (schoolId == 'alpha' && isAlphaDoc(incoming()) && isAlphaSchoolAdmin());
      }

      match /branding/{docId} {
        allow read: if isPrimaryAdmin() || (schoolId == 'alpha' && isAlphaUser());
        allow write: if (isPrimaryAdmin() && incoming().schoolId == schoolId) || (schoolId == 'alpha' && isAlphaDoc(incoming()) && isAlphaSchoolAdmin());
      }

      match /settings/{docId} {
        allow read: if isPrimaryAdmin() || (schoolId == 'alpha' && isAlphaUser());
        allow write: if (isPrimaryAdmin() && incoming().schoolId == schoolId) || (schoolId == 'alpha' && isAlphaDoc(incoming()) && isAlphaSchoolAdmin());
      }

      match /notifications/{docId} {
        allow read: if isPrimaryAdmin() || (schoolId == 'alpha' && isAlphaUser());
        allow create: if (isPrimaryAdmin() && incoming().schoolId == schoolId) || (schoolId == 'alpha' && isAlphaDoc(incoming()) && isAlphaRole(['schoolAdmin', 'teacher', 'student']));
        allow update: if (isPrimaryAdmin() && incoming().schoolId == schoolId) || (schoolId == 'alpha' && isAlphaDoc(incoming()) && isAlphaRole(['schoolAdmin', 'teacher']));
        allow delete: if isPrimaryAdmin() || (schoolId == 'alpha' && isAlphaSchoolAdmin());
      }

      match /readStates/{userId} {
        allow get: if isPrimaryAdmin() || (schoolId == 'alpha' && isSignedIn() && request.auth.uid == userId);
        allow create, update: if schoolId == 'alpha' && isSignedIn() && request.auth.uid == userId && incoming().userId == request.auth.uid && incoming().schoolId == 'alpha';
        allow delete: if false;
      }

      match /publicWebsite/{docId} {
        allow read: if schoolId == 'alpha' || isPrimaryAdmin();
        allow create, update, delete: if isPrimaryAdmin() || (schoolId == 'alpha' && isAlphaSchoolAdmin());
      }

      match /publicWebsite/{section}/{container}/{docId} {
        allow read: if (section != 'inquiries' && schoolId == 'alpha') || isPrimaryAdmin() || (schoolId == 'alpha' && isAlphaSchoolAdmin());
        allow create, update, delete: if section != 'inquiries' && (isPrimaryAdmin() || (schoolId == 'alpha' && isAlphaSchoolAdmin()));
      }

      match /publicWebsite/inquiries/items/{docId} {
        allow create: if schoolId == 'alpha' &&
          request.resource.data.schoolId == 'alpha' &&
          request.resource.data.status == 'new' &&
          request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 120 &&
          request.resource.data.email is string && request.resource.data.email.size() <= 180 &&
          request.resource.data.phone is string && request.resource.data.phone.size() <= 40 &&
          request.resource.data.subject is string && request.resource.data.subject.size() <= 160 &&
          request.resource.data.message is string && request.resource.data.message.size() >= 5 && request.resource.data.message.size() <= 3000;
        allow read, update, delete: if isPrimaryAdmin() || (schoolId == 'alpha' && isAlphaSchoolAdmin());
      }

      match /academicYears/{docId} {
        allow read: if isPrimaryAdmin() || (schoolId == 'alpha' && isAlphaUser());
        allow write: if isPrimaryAdmin() || (schoolId == 'alpha' && isAlphaSchoolAdmin());
      }

      match /forms/{docId} {
        allow read: if isPrimaryAdmin() || (schoolId == 'alpha' && isAlphaUser());
        allow write: if isPrimaryAdmin() || (schoolId == 'alpha' && isAlphaSchoolAdmin());
      }

      match /streams/{docId} {
        allow read: if isPrimaryAdmin() || (schoolId == 'alpha' && isAlphaUser());
        allow write: if isPrimaryAdmin() || (schoolId == 'alpha' && isAlphaSchoolAdmin());
      }

      match /subjectOfferings/{docId} {
        allow read: if isPrimaryAdmin() || (schoolId == 'alpha' && isAlphaUser());
        allow write: if isPrimaryAdmin() || (schoolId == 'alpha' && isAlphaSchoolAdmin());
      }

      match /attendanceSessions/{docId} {
        allow read: if isPrimaryAdmin() || (schoolId == 'alpha' && isAlphaUser());
        allow create, update: if isPrimaryAdmin() || (schoolId == 'alpha' && (isAlphaSchoolAdmin() || isAlphaTeacher()));
        allow delete: if isPrimaryAdmin() || (schoolId == 'alpha' && isAlphaSchoolAdmin());
      }

      match /attendanceRecords/{docId} {
        allow read: if isPrimaryAdmin() || (schoolId == 'alpha' && isAlphaUser());
        allow create, update: if isPrimaryAdmin() || (schoolId == 'alpha' && (
          isAlphaSchoolAdmin() ||
          isAlphaTeacher() ||
          (isAlphaRole(['student']) && incoming().studentUid == request.auth.uid)
        ));
        allow delete: if isPrimaryAdmin() || (schoolId == 'alpha' && isAlphaSchoolAdmin());
      }

      match /{alphaTenantPath=**} {
        allow read, write: if isPrimaryAdmin() || (schoolId == 'alpha' && isAlphaSchoolAdmin());
      }
    }

    match /platformLogs/{logId} {
      allow read, write: if isPrimaryAdmin();
    }

    match /admins/{adminId} {
      allow read, write: if isSuperAdmin();
    }
    match /feedback/{feedbackId} {
      allow create: if isSignedIn()
        && incoming().keys().hasOnly([
          'userId', 'userName', 'userEmail', 'rating', 'selectedReasons', 'message',
          'page', 'language', 'sectionName', 'createdAt', 'status'
        ])
        && incoming().userId == request.auth.uid
        && incoming().userEmail == request.auth.token.email
        && incoming().rating is number
        && incoming().rating >= 1
        && incoming().rating <= 5
        && incoming().status == "new";
      allow read, update, delete: if isSuperAdmin();
    }
    match /site_settings/{settingId} { allow read: if true; }
    match /faqs/{faqId} { allow read: if true; }
    match /chaba_products/{productId} { allow read: if true; }
    match /chaba_payment_methods/{methodId} { allow read: if true; }
    match /subscription_plans/{planId} { allow read: if true; }
    match /products/{productId} { 
      allow read: if true;
      allow create: if isSuperAdmin() || isRole(['admin', 'manager', 'seller']) && (incoming().sellerId == request.auth.uid || incoming().ownerId == request.auth.uid);
      allow update, delete: if isSuperAdmin() || isRole(['admin', 'manager']) || (isRole(['seller']) && (resource.data.ownerId == request.auth.uid || resource.data.sellerId == request.auth.uid));
    }

    match /creators/{creatorId} {
      allow read: if true;
      allow create: if isSignedIn() && (incoming().userId == request.auth.uid || isSuperAdmin()) && (
        !incoming().keys().hasAny(['verified']) || incoming().verified == false || isSuperAdmin()
      );
      allow update: if isSuperAdmin() || (isSignedIn() && existing().userId == request.auth.uid && (
        !incoming().diff(existing()).affectedKeys().hasAny(['verified', 'stats', 'earnings']) || isSuperAdmin()
      ));
      allow delete: if isSuperAdmin();
    }

    match /videos/{videoId} {
      allow read: if resource.data.visibility == 'public' || isSuperAdmin() || (isSignedIn() && get(/databases/$(database)/documents/creators/$(resource.data.creatorId)).data.userId == request.auth.uid);
      allow create: if isSignedIn() && (
        isSuperAdmin() || 
        get(/databases/$(database)/documents/creators/$(incoming().creatorId)).data.userId == request.auth.uid
      );
      allow update, delete: if isSuperAdmin() || (
        isSignedIn() && 
        get(/databases/$(database)/documents/creators/$(resource.data.creatorId)).data.userId == request.auth.uid
      );

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn() && incoming().userId == request.auth.uid;
        allow update, delete: if isSuperAdmin() || (isSignedIn() && (resource.data.userId == request.auth.uid || get(/databases/$(database)/documents/creators/$(get(/databases/$(database)/documents/videos/$(videoId)).data.creatorId)).data.userId == request.auth.uid));
      }

      match /likes/{userId} {
        allow read: if true;
        allow write: if isSignedIn() && userId == request.auth.uid;
      }
    }

    match /jobs/{jobId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSuperAdmin() || isRole(['admin', 'manager']);
    }

    match /services/{serviceId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isRole(['admin', 'manager']);
    }

    match /analytics/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isRole(['admin', 'manager']);
    }


    // ── USERS & PROFILE ──────────────────────────────────
    match /users/{userId} {
      // Signed-in members can view public profile data for community leaderboards.
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId && (
        isSuperAdmin() ||
        isAlphaOwnProfileAttachment(incoming()) ||
        !request.resource.data.keys().hasAny(['role', 'roles', 'admin', 'isAdmin', 'permissions', 'status']) ||
        request.resource.data.get('role', 'user') == 'user'
      );
      allow update: if (isSignedIn() && request.auth.uid == userId && (
        isSuperAdmin() || isAlphaOwnProfileAttachment(incoming()) || isReferralSetup(userId) || isReferralAttribution(userId) || (keepsProtectedUserFields() &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'referralCount', 'referralPoints', 'referralBadges', 'referredBy', 'referralCodeUsed'
          ]))
        )
      ) || isReferralAward(userId) || (
        (isSuperAdmin() || isClassroomTeacher()) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['joinedClassIds', 'updatedAt'])
      );
      allow delete: if isSuperAdmin();
      allow read, write, list: if isSuperAdmin();

      match /pushTokens/{tokenId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      match /followers/{followerId} {
        allow read: if true;
        allow write: if isSignedIn() && request.auth.uid == followerId;
      }

      match /following/{followingId} {
        allow read: if true;
        allow write: if isSignedIn() && request.auth.uid == userId;
      }

      match /savedResources/{resourceId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow write: if isSignedIn() && request.auth.uid == userId;
      }

      match /joinedForums/{forumName} {
        allow read: if true;
        allow write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // ── REFERRALS ────────────────────────────────────────
    match /referralCodes/{code} {
      allow read: if true;
      allow create: if isSignedIn()
        && incoming().ownerId == request.auth.uid
        && incoming().keys().hasOnly(['ownerId', 'createdAt']);
      allow update, delete: if isSuperAdmin();
    }

    match /referralClicks/{clickId} {
      allow create: if incoming().keys().hasOnly(['code', 'referrerId', 'path', 'createdAt']);
      allow read, update, delete: if isSuperAdmin();
    }

    match /referrals/{inviteeId} {
      allow create: if isSignedIn()
        && request.auth.uid == inviteeId
        && incoming().inviteeId == request.auth.uid
        && incoming().status == 'completed'
        && incoming().rewardPoints == 50
        && get(/databases/$(database)/documents/referralCodes/$(incoming().referralCode)).data.ownerId == incoming().referrerId
        && incoming().referrerId != request.auth.uid;
      allow get: if isSignedIn() && (request.auth.uid == inviteeId || resource.data.referrerId == request.auth.uid || isSuperAdmin());
      allow list, update, delete: if isSuperAdmin();
    }

    // ── NOTIFICATIONS ────────────────────────────────────
    match /notificationTokens/{tokenId} {
      allow get, list: if isSuperAdmin();
      allow create, update: if request.resource.data.keys().hasOnly([
          'token', 'userId', 'userEmail', 'createdAt', 'updatedAt', 'platform', 'userAgent', 'topics', 'status'
        ])
        && request.resource.data.token == tokenId
        && request.resource.data.status == 'active'
        && request.resource.data.topics == ['general']
        && (
          (request.resource.data.userId == null && request.resource.data.userEmail == null) ||
          (
            isSignedIn() &&
            request.resource.data.userId == request.auth.uid &&
            request.resource.data.userEmail == request.auth.token.email
          )
        );
      allow delete: if isSuperAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isSuperAdmin() || (isSignedIn() && (resource.data.target == 'all' || resource.data.userId == request.auth.uid));
      allow create: if isSuperAdmin() || (isSignedIn() && (
        incoming().userId == request.auth.uid || 
        (incoming().keys().hasAny(['classId']) && (
          isClassTeacher(incoming().classId) || 
          isClassStudent(incoming().classId) ||
          request.auth.uid == incoming().get('studentUid', '') ||
          request.auth.uid == incoming().get('createdBy', '')
        ))
      ));
      allow update: if isSuperAdmin() || 
        (isSignedIn() && resource.data.userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['isRead'])) ||
        (isSignedIn() && resource.data.target == 'all' && incoming().diff(existing()).affectedKeys().hasOnly(['readBy']) && request.auth.uid in incoming().readBy);
      allow delete: if isSuperAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // ── WORKSPACES ──────────────────────────────────────
    match /ceoWorkspace/{uid}/{document=**} {
      allow read, write: if isCeo(uid);
    }

    // ── E-COMMERCE & ORDERS ──────────────────────────────
    match /orders/{orderId} {
      allow create: if isSignedIn();
      allow read, list: if isSignedIn() && (
        isSuperAdmin() || 
        resource.data.userId == request.auth.uid || 
        resource.data.sellerId == request.auth.uid
      );
      allow update: if isSignedIn() && (
        isSuperAdmin() || 
        resource.data.sellerId == request.auth.uid
      );
    }
    
    match /chaba_orders/{orderId} {
      allow create: if isSignedIn();
      allow read, write: if isSuperAdmin();
    }

    match /marketplace_orders/{orderId} {
      allow create: if isSignedIn();
      allow read, list: if isSignedIn() && (
        isSuperAdmin() || 
        resource.data.userId == request.auth.uid || 
        resource.data.sellerId == request.auth.uid
      );
      allow update: if isSignedIn() && (
        isSuperAdmin() || 
        resource.data.sellerId == request.auth.uid
      );
    }

    // ── SERVICES & SUBSCRIPTIONS ──────────────────────────
    match /subscriptionServices/{serviceId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    match /servicePlans/{planId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    match /servicePaymentMethods/{methodId} {
      allow get, list: if isSuperAdmin() || resource.data.isActive == true;
      allow create, update, delete: if isSuperAdmin();
    }
    match /serviceSubscriptions/{subscriptionId} {
      allow create: if request.resource.data.keys().hasAll([
          'serviceId', 'serviceTitle', 'planId', 'planName', 'fullName', 'email',
          'whatsapp', 'country', 'currency', 'amount', 'paymentMethod',
          'status', 'createdAt'
        ])
        && request.resource.data.status == "pending"
        && (
          (isSignedIn() && request.resource.data.get('userId', '') == request.auth.uid) ||
          request.resource.data.get('userId', null) == null
        );
      allow get: if isSuperAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list, update, delete: if isSuperAdmin();
    }

    // ── DIGITAL TOOLS ────────────────────────────────────
    match /digital_tools/{toolId} { allow read: if true; allow write: if isSuperAdmin(); }
    match /digitalTools/{toolId} { allow read: if true; allow write: if isSuperAdmin(); }
    match /toolPlans/{planId} { allow read: if true; allow write: if isSuperAdmin(); }
    
    match /toolSubscriptions/{subscriptionId} {
      allow create: if request.resource.data.keys().hasAll([
          'toolId', 'toolTitle', 'planId', 'planName', 'fullName', 'email',
          'whatsapp', 'country', 'currency', 'amount', 'paymentMethod',
          'paymentReference', 'status', 'source', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.status == "pending"
        && (
          (isSignedIn() && request.resource.data.get('userId', '') == request.auth.uid) ||
          request.resource.data.get('userId', null) == null
        );
      allow get: if isSuperAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list, update, delete: if isSuperAdmin();
    }

    // ── CLASSROOM & ATTENDANCE SYSTEM ────────────────────────────────
    
    // Primitives for Classroom
    function isValidClassId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    
    function isClassTeacher(classId) {
      return isSignedIn() && (
        isSuperAdmin() || 
        (exists(/databases/$(database)/documents/classes/$(classId)) && (
          get(/databases/$(database)/documents/classes/$(classId)).data.get('teacherId', '') == request.auth.uid ||
          get(/databases/$(database)/documents/classes/$(classId)).data.get('createdBy', '') == request.auth.uid ||
          (request.auth.token.email != null && get(/databases/$(database)/documents/classes/$(classId)).data.get('teacherEmail', '') == request.auth.token.email)
        )) ||
        (exists(/databases/$(database)/documents/attendanceClasses/$(classId)) && (
          get(/databases/$(database)/documents/attendanceClasses/$(classId)).data.get('teacherId', '') == request.auth.uid ||
          get(/databases/$(database)/documents/attendanceClasses/$(classId)).data.get('createdBy', '') == request.auth.uid ||
          (request.auth.token.email != null && get(/databases/$(database)/documents/attendanceClasses/$(classId)).data.get('teacherEmail', '') == request.auth.token.email)
        ))
      );
    }

    function isClassEnrollmentStudent(classId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/classEnrollments/$(classId + '_' + request.auth.uid)) &&
        get(/databases/$(database)/documents/classEnrollments/$(classId + '_' + request.auth.uid)).data.status == 'active' &&
        get(/databases/$(database)/documents/classEnrollments/$(classId + '_' + request.auth.uid)).data.studentId == request.auth.uid;
    }

    function isNestedClassStudent(classId) {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/classes/$(classId)/classStudents/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/classes/$(classId)/classStudents/$(request.auth.uid)).data.status == 'active') ||
        (exists(/databases/$(database)/documents/classes/$(classId)/students/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/classes/$(classId)/students/$(request.auth.uid)).data.status == 'active' ||
          get(/databases/$(database)/documents/classes/$(classId)/students/$(request.auth.uid)).data.role == 'student')) ||
        (exists(/databases/$(database)/documents/attendanceClasses/$(classId)/classStudents/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/attendanceClasses/$(classId)/classStudents/$(request.auth.uid)).data.status == 'active') ||
        (exists(/databases/$(database)/documents/attendanceClasses/$(classId)/students/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/attendanceClasses/$(classId)/students/$(request.auth.uid)).data.status == 'active' ||
          get(/databases/$(database)/documents/attendanceClasses/$(classId)/students/$(request.auth.uid)).data.role == 'student'))
      );
    }

    function isClassStudent(classId) {
      return isClassEnrollmentStudent(classId) || isNestedClassStudent(classId);
    }

    function isActiveAttendanceSession(sessionId) {
      return exists(/databases/$(database)/documents/attendanceSessions/$(sessionId)) &&
        get(/databases/$(database)/documents/attendanceSessions/$(sessionId)).data.status == 'active' &&
        get(/databases/$(database)/documents/attendanceSessions/$(sessionId)).data.isActive == true;
    }

    function isQuizTeacher(quizId) {
      return isSignedIn() && (
        isSuperAdmin() ||
        isClassTeacher(get(/databases/$(database)/documents/quizzes/$(quizId)).data.classId)
      );
    }

    // Validation Blueprints
    function isValidClass(data) {
      return data.keys().hasAll(['className', 'teacherId', 'teacherEmail', 'teacherName', 'createdBy', 'classCode', 'joinCode', 'code', 'status', 'deleted', 'createdAt'])
        && data.teacherId == request.auth.uid
        && data.createdBy == request.auth.uid
        && data.status == 'active'
        && data.deleted == false
        && data.classCode == data.joinCode
        && data.classCode == data.code
        && data.classCode.matches('^[A-Z0-9]{6,}$');
    }

    function classInviteIsOpen(classId, data) {
      return data.classId == classId
        && data.status in ['active', 'pending']
        && data.role == 'student'
        && data.fullName is string
        && data.fullName.size() >= 2
        && data.fullName.size() <= 120
        && data.studentId is string
        && data.studentId.size() >= 2
        && data.studentId.size() <= 80
        && data.email is string
        && data.email.size() <= 160
        && data.phone is string
        && data.phone.size() <= 60
        && data.department is string
        && data.department.size() <= 120
        && data.note is string
        && data.note.size() <= 500
        && data.notes == data.note
        && data.studentRegNo == data.studentId
        && data.studentName == data.fullName
        && data.studentEmail == data.email
        && data.studentPhone == data.phone
        && data.classDepartment == data.department
        && data.studentUid == data.uid
        && data.studentUid == data.joinKey
        && data.joinedAt == request.time
        && (
          (isSignedIn() && data.joinedBy == request.auth.uid && data.publicJoin == false && data.uid == request.auth.uid) ||
          (!isSignedIn() && data.joinedBy == null && data.publicJoin == true && data.uid.matches('^guest_[a-z0-9]+$'))
        )
        && (
          (
            exists(/databases/$(database)/documents/classes/$(classId)) &&
            get(/databases/$(database)/documents/classes/$(classId)).data.get('status', 'active') == 'active' &&
            get(/databases/$(database)/documents/classes/$(classId)).data.get('deleted', false) == false &&
            data.teacherId == get(/databases/$(database)/documents/classes/$(classId)).data.get('teacherId', get(/databases/$(database)/documents/classes/$(classId)).data.get('createdBy', '')) &&
            data.classCode in [
              get(/databases/$(database)/documents/classes/$(classId)).data.get('classCode', ''),
              get(/databases/$(database)/documents/classes/$(classId)).data.get('joinCode', ''),
              get(/databases/$(database)/documents/classes/$(classId)).data.get('code', '')
            ]
          ) ||
          (
            exists(/databases/$(database)/documents/attendanceClasses/$(classId)) &&
            get(/databases/$(database)/documents/attendanceClasses/$(classId)).data.get('status', 'active') == 'active' &&
            get(/databases/$(database)/documents/attendanceClasses/$(classId)).data.get('deleted', false) == false &&
            data.teacherId == get(/databases/$(database)/documents/attendanceClasses/$(classId)).data.get('teacherId', get(/databases/$(database)/documents/attendanceClasses/$(classId)).data.get('createdBy', '')) &&
            data.classCode in [
              get(/databases/$(database)/documents/attendanceClasses/$(classId)).data.get('classCode', ''),
              get(/databases/$(database)/documents/attendanceClasses/$(classId)).data.get('joinCode', ''),
              get(/databases/$(database)/documents/attendanceClasses/$(classId)).data.get('code', '')
            ]
          )
        );
    }

    function isValidClassJoinRecord(classId, studentDocId) {
      return incoming().joinKey == studentDocId
        && incoming().keys().hasOnly([
          'classId', 'classCode', 'joinCode', 'studentUid', 'uid', 'studentId',
          'studentRegNo', 'studentName', 'fullName', 'studentEmail', 'email',
          'studentPhone', 'phone', 'department', 'classDepartment', 'note',
          'notes', 'joinedAt', 'joinedBy', 'publicJoin', 'joinKey', 'teacherId',
          'status', 'role'
        ])
        && classInviteIsOpen(classId, incoming());
    }

    function isValidClassJoinKey(classId, joinKeyId) {
      return incoming().keys().hasOnly(['classId', 'kind', 'valueHash', 'studentRef', 'createdAt'])
        && incoming().classId == classId
        && incoming().kind in ['studentId', 'email']
        && incoming().valueHash is string
        && incoming().valueHash.matches('^[a-z0-9]+$')
        && incoming().studentRef is string
        && incoming().createdAt == request.time
        && joinKeyId == incoming().kind + '_' + incoming().valueHash
        && (
          existsAfter(/databases/$(database)/documents/classes/$(classId)/classStudents/$(incoming().studentRef)) ||
          existsAfter(/databases/$(database)/documents/attendanceClasses/$(classId)/classStudents/$(incoming().studentRef))
        );
    }

    match /classCodes/{code} {
      allow get: if code.matches('^[A-Z0-9]{6,}$');
      allow list: if isSignedIn() && isSuperAdmin();
      allow create: if isSignedIn()
        && code.matches('^[A-Z0-9]{6,}$')
        && incoming().teacherId == request.auth.uid
        && incoming().classId is string;
      allow update: if isSignedIn() && (
        isSuperAdmin() || resource.data.teacherId == request.auth.uid
      );
      allow delete: if isSuperAdmin();
    }

    match /classEnrollments/{docId} {
      allow create: if isSignedIn() && (
        isSuperAdmin() ||
        (
          incoming().studentId == request.auth.uid &&
          incoming().studentUid == request.auth.uid &&
          incoming().classId is string &&
          incoming().status in ['active', 'pending']
        ) ||
        (
          incoming().teacherId == request.auth.uid &&
          incoming().classId is string &&
          isClassTeacher(incoming().classId)
        )
      );
      allow get, list: if isSignedIn() && (
        isSuperAdmin() ||
        resource.data.studentId == request.auth.uid ||
        resource.data.studentUid == request.auth.uid ||
        resource.data.teacherId == request.auth.uid ||
        isClassTeacher(resource.data.classId)
      );
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        resource.data.teacherId == request.auth.uid ||
        isClassTeacher(resource.data.classId) ||
        (
          resource.data.studentId == request.auth.uid &&
          incoming().studentId == request.auth.uid &&
          incoming().studentUid == request.auth.uid &&
          incoming().classId == resource.data.classId
        )
      );
      allow delete: if isSignedIn() && (
        isSuperAdmin() ||
        resource.data.teacherId == request.auth.uid ||
        isClassTeacher(resource.data.classId)
      );
    }

    function isValidAssignment(data) {
      return data.keys().hasAll(['classId', 'teacherId', 'title', 'status', 'createdAt'])
        && data.teacherId == request.auth.uid
        && data.status in ['published', 'draft', 'deleted'];
    }

    function isValidSubmission(data) {
      return data.keys().hasAll(['assignmentId', 'classId', 'studentUserId', 'studentName', 'submittedAt', 'status'])
        && data.studentUserId == request.auth.uid
        && data.status in ['submitted', 'marked'];
    }

    function keepsSubmissionProtectedFields() {
      return !incoming().diff(existing()).affectedKeys().hasAny([
        'marks', 'feedback', 'teacherComment', 'gradedBy', 'gradedAt', 'markedBy', 'markedAt'
      ]);
    }

    match /attendanceClasses/{classId} {
      allow get: if isSignedIn() || (
        resource.data.get('status', 'active') == 'active' &&
        resource.data.get('deleted', false) == false &&
        resource.data.get('classCode', resource.data.get('joinCode', resource.data.get('code', ''))).matches('^[A-Z0-9]{6,}$')
      );
      allow list: if isSignedIn();
      allow create: if isSuperAdmin() || (isSignedIn() && isValidClass(incoming()));
      allow update: if isSuperAdmin() || isClassTeacher(classId) || (
        isSignedIn() &&
        incoming().diff(existing()).affectedKeys().hasOnly(['studentCount', 'students', 'studentUids']) &&
        request.auth.uid in incoming().students &&
        request.auth.uid in incoming().studentUids
      );
      allow delete: if isSuperAdmin();

      match /attendance/{recordId} {
         allow read: if isSignedIn() && (isClassTeacher(classId) || existing().userId == request.auth.uid);
         allow create: if isSignedIn();
         allow update, delete: if isClassTeacher(classId);
      }
      
      match /resources/{resourceId} {
         allow read: if isClassStudent(classId) || isClassTeacher(classId);
         allow write: if isClassTeacher(classId);
      }
      match /announcements/{annId} {
         allow read: if isClassStudent(classId) || isClassTeacher(classId);
         allow write: if isClassTeacher(classId);
      }
      match /classStudents/{studentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && isClassTeacher(classId);
        allow update, delete: if isSuperAdmin() || isClassTeacher(classId) || (
          request.auth.uid == studentId && existing().status == 'active' && incoming().status == 'active'
        );
      }

      match /students/{studentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && isClassTeacher(classId);
        allow update, delete: if isSuperAdmin() || isClassTeacher(classId) || (
          request.auth.uid == studentId
        );
      }

      match /joinKeys/{joinKeyId} {
        allow create: if isClassTeacher(classId) || isSuperAdmin();
        allow get: if isClassTeacher(classId) || isSuperAdmin();
        allow list, update, delete: if isClassTeacher(classId) || isSuperAdmin();
      }
    }

    // Legacy/standard classes support nested rules exactly in sync
    match /classes/{classId} {
      allow get: if isSignedIn() || (
        resource.data.get('status', 'active') == 'active' &&
        resource.data.get('deleted', false) == false &&
        resource.data.get('classCode', resource.data.get('joinCode', resource.data.get('code', ''))).matches('^[A-Z0-9]{6,}$')
      );
      allow list: if isSignedIn();
      allow create: if isSuperAdmin() || (isSignedIn() && isValidClass(incoming()));
      allow update: if isSuperAdmin() || isClassTeacher(classId) || (
        isSignedIn() &&
        incoming().diff(existing()).affectedKeys().hasOnly(['studentCount', 'students', 'studentUids']) &&
        request.auth.uid in incoming().students &&
        request.auth.uid in incoming().studentUids
      );
      allow delete: if isSuperAdmin();

      match /attendance/{recordId} {
         allow read: if isSignedIn() && (isClassTeacher(classId) || existing().userId == request.auth.uid);
         allow create: if isSignedIn();
         allow update, delete: if isClassTeacher(classId);
      }
      
      match /resources/{resourceId} {
         allow read: if isClassStudent(classId) || isClassTeacher(classId);
         allow write: if isClassTeacher(classId);
      }
      match /announcements/{annId} {
         allow read: if isClassStudent(classId) || isClassTeacher(classId);
         allow write: if isClassTeacher(classId);
      }
      match /classStudents/{studentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && isClassTeacher(classId);
        allow update, delete: if isSuperAdmin() || isClassTeacher(classId) || (
          request.auth.uid == studentId && existing().status == 'active' && incoming().status == 'active'
        );
      }

      match /students/{studentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && isClassTeacher(classId);
        allow update, delete: if isSuperAdmin() || isClassTeacher(classId) || (
          request.auth.uid == studentId
        );
      }

      match /joinKeys/{joinKeyId} {
        allow create: if isClassTeacher(classId) || isSuperAdmin();
        allow get: if isClassTeacher(classId) || isSuperAdmin();
        allow list, update, delete: if isClassTeacher(classId) || isSuperAdmin();
      }
    }

    match /attendanceSessions/{sessionId} {
      allow create: if isSuperAdmin() || (isSignedIn() && incoming().teacherId == request.auth.uid && isClassTeacher(incoming().classId));
      allow get: if isSignedIn() && (
        isSuperAdmin() || isClassTeacher(resource.data.classId) ||
        (isClassStudent(resource.data.classId) && resource.data.status == 'active' && resource.data.isActive == true)
      );
      allow list: if isSignedIn() && (
        isSuperAdmin() || isClassTeacher(resource.data.classId) ||
        (isClassStudent(resource.data.classId) && resource.data.status == 'active' && resource.data.isActive == true)
      );
      allow update: if isSuperAdmin() || isClassTeacher(resource.data.classId);
      allow delete: if isSuperAdmin() || isClassTeacher(resource.data.classId);

      match /records/{studentUid} {
        allow read: if isSignedIn() && (
          isSuperAdmin() || 
          isClassTeacher(get(/databases/$(database)/documents/attendanceSessions/$(sessionId)).data.classId) || 
          request.auth.uid == studentUid
        );
        allow create: if isSignedIn() && request.auth.uid == studentUid && incoming().userId == request.auth.uid &&
          isActiveAttendanceSession(sessionId) &&
          isClassStudent(get(/databases/$(database)/documents/attendanceSessions/$(sessionId)).data.classId) &&
          !isClassTeacher(get(/databases/$(database)/documents/attendanceSessions/$(sessionId)).data.classId) &&
          incoming().sessionId == sessionId &&
          incoming().classId == get(/databases/$(database)/documents/attendanceSessions/$(sessionId)).data.classId;
        allow update, delete: if isSuperAdmin() || isClassTeacher(get(/databases/$(database)/documents/attendanceSessions/$(sessionId)).data.classId);
      }
    }

    match /classReadStates/{readStateId} {
      // Read-state document IDs are deterministic but never listable; a get is
      // allowed so a new student's not-yet-created document can be observed.
      allow get: if isSignedIn();
      allow create: if isSignedIn() && incoming().userId == request.auth.uid &&
        isClassStudent(incoming().classId) && !isClassTeacher(incoming().classId);
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid &&
        incoming().userId == request.auth.uid && incoming().classId == resource.data.classId;
      allow delete: if false;
    }

    match /attendanceRecords/{recordId} {
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && isClassStudent(incoming().classId);
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.teacherId == request.auth.uid);
      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        resource.data.teacherId == request.auth.uid
      );
      allow update: if isSignedIn() && (resource.data.teacherId == request.auth.uid || resource.data.userId == request.auth.uid);
      allow delete: if isSignedIn() && (resource.data.teacherId == request.auth.uid);
    }

    match /assignments/{assignmentId} {
      allow read: if isSignedIn() && (
        isSuperAdmin() ||
        isClassTeacher(resource.data.classId) ||
        isClassStudent(resource.data.classId)
      );
      allow create: if isSuperAdmin() || (isSignedIn() && isValidAssignment(incoming()) && isClassTeacher(incoming().classId));
      allow update: if isSuperAdmin() || (isClassTeacher(resource.data.classId) && isValidAssignment(incoming()) && (
        incoming().teacherId == existing().teacherId &&
        incoming().createdAt == existing().createdAt
      ));
      allow delete: if isSuperAdmin() || isClassTeacher(resource.data.classId);
    }

    match /assignmentSubmissions/{submissionId} {
      // Query Enforcer: Students only list their own, Teachers list all for their class
      allow list: if isSignedIn() && (
        isSuperAdmin() ||
        (request.query.limit <= 50) && ( // Basic safety
          resource.data.studentUserId == request.auth.uid ||
          isClassTeacher(resource.data.classId)
        )
      );
      
      allow get: if isSignedIn() && (
        isSuperAdmin() ||
        (isClassStudent(resource.data.classId) && resource.data.studentUserId == request.auth.uid) ||
        isClassTeacher(resource.data.classId)
      );

      allow create: if isSignedIn() && isValidSubmission(incoming()) && (
        isSuperAdmin() || incoming().studentUserId == request.auth.uid
      ) && isClassStudent(incoming().classId) && (
        !exists(/databases/$(database)/documents/assignmentSubmissions/$(submissionId))
      );

      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        // Action: Student Edit (Only before marking and only certain fields)
        (resource.data.studentUserId == request.auth.uid && 
         !(resource.data.status in ['marked', 'graded']) &&
         keepsSubmissionProtectedFields() &&
         incoming().diff(existing()).affectedKeys().hasOnly(['textAnswer', 'fileUrls', 'fileUrl', 'fileName', 'fileType', 'submittedAt', 'isLate', 'status', 'studentName', 'studentId', 'studentRegNo', 'studentPhone', 'studentEmail', 'email']) &&
         incoming().studentUserId == existing().studentUserId
        ) ||
        // Action: Teacher Marking
        (isClassTeacher(resource.data.classId) && 
         incoming().diff(existing()).affectedKeys().hasOnly(['marks', 'feedback', 'teacherComment', 'gradedBy', 'gradedAt', 'markedAt', 'markedBy', 'status'])
        )
      );

      allow delete: if isSuperAdmin() || isClassTeacher(resource.data.classId) || (resource.data.studentUserId == request.auth.uid && resource.data.status != 'marked');
    }

    match /classResources/{resourceId} {
      allow read: if isSignedIn() && (
        isSuperAdmin() ||
        isClassTeacher(resource.data.classId) ||
        (isClassStudent(resource.data.classId) && (resource.data.status == 'published' || resource.data.visibility == 'published'))
      );
      allow create: if isSignedIn() &&
        incoming().classId is string &&
        isClassTeacher(incoming().classId) &&
        incoming().teacherId == request.auth.uid;
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (isClassTeacher(resource.data.classId) &&
          incoming().classId == resource.data.classId &&
          incoming().teacherId == resource.data.teacherId)
      );
      allow delete: if isSignedIn() && (isSuperAdmin() || isClassTeacher(resource.data.classId));
    }

    match /quizzes/{quizId} {
      allow read: if isSignedIn() && (isSuperAdmin() || isClassTeacher(resource.data.classId) || isClassStudent(resource.data.classId));
      allow create: if isSuperAdmin() || isClassTeacher(incoming().classId);
      allow update, delete: if isSuperAdmin() || isClassTeacher(resource.data.classId);

      match /submissions/{submissionId} {
        allow read: if isSignedIn() && (isSuperAdmin() || isQuizTeacher(quizId) || resource.data.userId == request.auth.uid);
        allow create: if isSignedIn() && incoming().userId == request.auth.uid && isClassStudent(get(/databases/$(database)/documents/quizzes/$(quizId)).data.classId);
      }
    }

    match /quizResults/{resultId} {
      allow create: if isSignedIn() && (
        incoming().studentUserId == request.auth.uid ||
        incoming().studentUid == request.auth.uid
      ) && isClassStudent(incoming().classId);
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        isClassTeacher(resource.data.classId) ||
        (
          resource.data.studentUid == request.auth.uid &&
          resource.data.quizId == incoming().quizId &&
          isClassStudent(resource.data.classId) &&
          get(/databases/$(database)/documents/quizzes/$(resource.data.quizId)).data.allowQuizRetake == true &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'quizId',
            'classId',
            'studentUid',
            'studentUserId',
            'studentName',
            'studentId',
            'studentRegNo',
            'studentEmail',
            'studentPhone',
            'answers',
            'score',
            'totalPoints',
            'percentage',
            'correctCount',
            'totalQuestions',
            'needsTeacherGrading',
            'status',
            'submittedAt',
            'attemptNumber',
            'attempts',
            'teacherId',
            'className'
          ])
        )
      );
      allow read: if isSignedIn() && (
        isSuperAdmin() ||
        resource.data.studentUserId == request.auth.uid ||
        resource.data.studentUid == request.auth.uid ||
        isClassTeacher(resource.data.classId)
      );
      allow delete: if isSuperAdmin() || (isSignedIn() && isClassTeacher(resource.data.classId));
    }

    match /classroomAuditLogs/{logId} {
      allow create: if isSignedIn() && (incoming().userId == request.auth.uid || isClassTeacher(incoming().classId));
      allow read: if isSignedIn() && (
        isSuperAdmin() ||
        resource.data.userId == request.auth.uid ||
        isClassTeacher(resource.data.classId)
      );
      allow update, delete: if isSuperAdmin();
    }

    match /audit_logs/{logId} {
      allow create: if isSignedIn() && incoming().keys().hasAll([
        'action', 'entity', 'entityId', 'classId', 'performedByUid', 'timestamp', 'source'
      ]) && isClassTeacher(incoming().classId);
      allow read, update, delete: if isSuperAdmin();
    }

    match /resources/{resourceId} {
      allow read: if resource.data.get('classId', '') == '' || (isSignedIn() && (isSuperAdmin() || isClassTeacher(resource.data.classId) || isClassStudent(resource.data.classId)));
      allow create: if isSuperAdmin() ||
        (isSignedIn() && incoming().get('classId', '') != '' && incoming().teacherId == request.auth.uid && isClassTeacher(incoming().classId)) ||
        (incoming().get('classId', '') == '' && isRole(['admin', 'editor', 'manager', 'creator']));
      allow update, delete: if isSuperAdmin() ||
        (resource.data.get('classId', '') != '' && isClassTeacher(resource.data.classId)) ||
        (resource.data.get('classId', '') == '' && isRole(['admin', 'editor', 'manager', 'creator']));
    }

    match /announcements/{announcementId} {
      allow read: if isSignedIn() && (isSuperAdmin() || isClassTeacher(resource.data.classId) || isClassStudent(resource.data.classId));
      allow create: if isSuperAdmin() || (isSignedIn() && incoming().teacherId == request.auth.uid && isClassTeacher(incoming().classId));
      allow update, delete: if isSuperAdmin() || isClassTeacher(resource.data.classId);

      match /comments/{commentId} {
        allow read: if isSignedIn() && (isSuperAdmin() || isClassTeacher(get(/databases/$(database)/documents/announcements/$(announcementId)).data.classId) || isClassStudent(get(/databases/$(database)/documents/announcements/$(announcementId)).data.classId));
        allow create: if isSignedIn() && incoming().authorId == request.auth.uid && isClassStudent(get(/databases/$(database)/documents/announcements/$(announcementId)).data.classId);
        allow update, delete: if isSuperAdmin() || request.auth.uid == resource.data.authorId || isClassTeacher(get(/databases/$(database)/documents/announcements/$(announcementId)).data.classId);
      }
    }



    // ── LEGACY & MISC ────────────────────────────────────
    match /service_requests/{reqId} { allow create: if isSignedIn(); allow read, write: if isSuperAdmin(); }
    match /paymentMethods/{methodId} {
      allow get, list: if isSuperAdmin() || resource.data.isActive == true;
      allow write: if isSuperAdmin();
    }
    match /subscriptionAnalytics/{analyticsId} { allow read, write: if isSuperAdmin(); }

    // ── STUDENT COMMUNITY & NETWORK SYSTEM ───────────────
    match /communities_posts/{postId} {
      allow read, list: if isSignedIn();
      allow create: if isSignedIn() && incoming().authorId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.authorId == request.auth.uid || 
        isSuperAdmin() || 
        incoming().diff(existing()).affectedKeys().hasOnly(['upvotes', 'upvotedBy', 'helpfulAnswerId', 'answersCount'])
      );
      allow delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isSuperAdmin());
    }

    match /communities_answers/{answerId} {
      allow read, list: if isSignedIn();
      allow create: if isSignedIn() && incoming().authorId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.authorId == request.auth.uid || 
        isSuperAdmin() || 
        incoming().diff(existing()).affectedKeys().hasOnly(['upvotes', 'upvotedBy', 'isHelpful'])
      );
      allow delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isSuperAdmin());
    }

    match /referrals/{referralId} {
      allow list: if isSignedIn(); // Each query must be securely filtered by the client so we enforce checks against data
      allow get: if isSignedIn() && (resource.data.referrerUid == request.auth.uid || isSuperAdmin());
      allow create: if isSignedIn() && incoming().referrerUid == request.auth.uid;
      allow update: if isSignedIn() && (incoming().referrerUid == request.auth.uid || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    match /ambassador_applications/{appId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn() && (resource.data.uid == request.auth.uid || isSuperAdmin());
      allow create: if isSignedIn() && incoming().uid == request.auth.uid;
      allow update, delete: if isSuperAdmin();
    }

    match /study_resources/{resourceId} {
      allow read: if isSuperAdmin() || isRole(['admin', 'editor', 'manager', 'creator']) || 
                  (resource.data.status in ['approved', 'published', 'active', 'featured']) ||
                  (isSignedIn() && resource.data.authorId == request.auth.uid);
      allow create: if isSignedIn() && 
                    request.resource.data.authorId == request.auth.uid &&
                    request.resource.data.status == 'pending';
      allow update: if isSignedIn() && (
                    (isSuperAdmin() || isRole(['admin', 'editor', 'manager'])) ||
                    (resource.data.authorId == request.auth.uid && 
                     request.resource.data.authorId == request.auth.uid &&
                     request.resource.data.status == resource.data.status)
                  );
      allow delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isSuperAdmin() || isRole(['admin', 'editor', 'manager']));

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
        allow delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isSuperAdmin());
      }
      match /likes/{userId} {
        allow read: if true;
        allow write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    match /reports/{reportId} {
      allow create: if isSignedIn();
      allow read, write: if isSuperAdmin() || isRole(['admin', 'editor', 'manager']);
    }

    match /websites/{docId} {
      allow read: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visits', 'views', 'favoritesCount', 'clicks', 'lastClickedAt', 'likesCount']);
    }

    match /websiteReports/{reportId} {
      allow create: if incoming().keys().hasOnly(['websiteId', 'websiteTitle', 'websiteUrl', 'reason', 'status', 'createdAt', 'userId'])
        && incoming().reason == 'broken_link'
        && incoming().status == 'pending'
        && (!isSignedIn() || incoming().userId == request.auth.uid || incoming().userId == null);
      allow read, update: if isSuperAdmin() || isRole(['admin', 'editor', 'manager']);
    }

    match /website_suggestions/{suggestionId} {
      allow create: if incoming().keys().hasOnly([
          'websiteName', 'websiteUrl', 'category', 'categorySlug', 'description',
          'reason', 'suggestedByName', 'suggestedByEmail', 'status', 'source',
          'createdAt', 'updatedAt'
        ])
        && incoming().keys().hasAll(['websiteName', 'websiteUrl', 'category', 'categorySlug', 'description', 'status', 'source', 'createdAt', 'updatedAt'])
        && incoming().websiteName is string
        && incoming().websiteUrl is string
        && incoming().category is string
        && incoming().categorySlug is string
        && incoming().description is string
        && incoming().get('reason', '') is string
        && incoming().get('suggestedByName', '') is string
        && incoming().get('suggestedByEmail', '') is string
        && incoming().status == 'pending'
        && incoming().source == 'public_category_page'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow read, update, delete: if isSuperAdmin() || isRole(['admin', 'editor', 'manager']);
    }

    // ── WEBSITE LIKES ─────────────────────────────────────
    match /websiteLikes/{likeId} {
      allow read: if true;
      allow create: if isSignedIn()
        && incoming().uid == request.auth.uid
        && incoming().keys().hasOnly(['websiteId', 'uid', 'createdAt']);
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // ── WEBSITE FEEDBACK ──────────────────────────────────
    match /websiteFeedback/{feedbackId} {
      allow read: if isSuperAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if (
        isSignedIn()
        && incoming().uid == request.auth.uid
        && incoming().keys().hasOnly(['websiteId', 'uid', 'userName', 'rating', 'comment', 'type', 'createdAt', 'status'])
        && incoming().rating is number
        && incoming().rating >= 1
        && incoming().rating <= 5
        && incoming().type in ['review', 'broken_link', 'suggestion']
        && incoming().status == 'pending'
      ) || (
        incoming().keys().hasOnly(['websiteId', 'websiteTitle', 'websiteUrl', 'feedbackType', 'message', 'createdAt', 'userId', 'status'])
        && incoming().feedbackType in ['helpful', 'wrong_category', 'bad_image', 'unsafe_spam', 'other']
        && incoming().status == 'pending'
        && (!isSignedIn() || incoming().userId == request.auth.uid || incoming().userId == null)
      );
      allow update, delete: if isSuperAdmin();
    }

    // ── APP INSTALL & USAGE TRACKING ─────────────────────
    match /stea_app_events/{eventId} {
      allow create: if incoming().keys().hasAll(['eventType', 'createdAt'])
        && incoming().eventType in ['install_prompt_shown', 'install_accepted', 'install_dismissed', 'app_opened_standalone', 'web_visit']
        && incoming().createdAt == request.time;
      allow read, update, delete: if isSuperAdmin() || isRole(['admin', 'editor', 'manager']);
    }

    match /stea_metrics/app_install {
      allow read: if isSuperAdmin() || isRole(['admin', 'editor', 'manager']);
      allow create, update: if request.resource.data.keys().hasOnly([
        'installPromptShownCount', 'installAcceptedCount', 'installDismissedCount', 'standaloneOpenCount', 'webVisitCount', 'updatedAt'
      ]);
    }

    match /{collectionName}/{docId} {
      allow read: if collectionName in [
        'tips', 'updates', 'news', 'websites', 'prompts', 'deals', 'courses', 
        'posts', 'ai', 'gigs', 'sponsored_ads', 'shop', 'content',
        'deliveries', 'marketplace', 'exams', 'payments', 'necta', 'message_templates', 'subscriptions', 'subscription_plans', 'content', 'ads', 'tech_tips',
        'website_solutions', 'prompt_lab', 'video_courses', 'learning_resources', 'marketplace_products', 'tanzania_products', 'promptLab', 'websiteSolutions',
        'necta_results', 'paymentSettings', 'admin_notifications', 'website_solution_categories', 'prompt_categories', 'course_categories', 'sponsored', 'tips_resources', 'tech_content',
        'education_notes', 'education_past_papers', 'notes', 'pastPapers', 'educationResources', 'uploads', 'classroomResources'
      ];
      allow write: if isSuperAdmin() || isRole(['admin', 'editor', 'manager', 'creator']);
    }

    // Global Catch-all (Admins only)
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
