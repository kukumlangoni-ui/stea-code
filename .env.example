# Cloudflare R2 credentials for STEA Code asset storage.
# Copy this file to .env and fill in your values. .env is gitignored.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://6055d433dd3690fe74f80e19ad5dff13.r2.cloudflarestorage.com
R2_BUCKET_NAME=steacode
R2_PUBLIC_URL=

# STEA Code API source for the local server (npm start / node dist/server.cjs).
# When set (default), localhost /api/stea-code and /api/admin/stea-code are
# proxied to this origin — the Cloudflare Worker, which reads the real D1
# database. Set to empty to fall back to the local Firestore/seed handlers.
STEA_CODE_API_ORIGIN=https://steacode.com
