rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() &&
        request.auth.token.email != null &&
        request.auth.token.email.lower() == "stea.africa@gmail.com";
    }

    function hasUserProfile() {
      return isSignedIn() &&
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function isAdminUploader() {
      return isSuperAdmin() ||
        (hasUserProfile() &&
          firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in [
            "admin",
            "super_admin",
            "manager",
            "editor",
            "creator"
          ]);
    }

    // Classroom assignments storage helpers
    function hasClass(classId) {
      return firestore.exists(/databases/(default)/documents/classes/$(classId)) ||
             firestore.exists(/databases/(default)/documents/attendanceClasses/$(classId));
    }

    function hasAttendanceClass(classId) {
      return firestore.exists(/databases/(default)/documents/attendanceClasses/$(classId));
    }

    function isTeacher(classId) {
      return isSignedIn() && (
        isSuperAdmin() ||
        (hasClass(classId) &&
          (firestore.get(/databases/(default)/documents/classes/$(classId)).data.get('teacherId', '') == request.auth.uid ||
           firestore.get(/databases/(default)/documents/classes/$(classId)).data.get('createdBy', '') == request.auth.uid ||
           (request.auth.token.email != null && firestore.get(/databases/(default)/documents/classes/$(classId)).data.get('teacherEmail', '') == request.auth.token.email)))
      );
    }

    function isStudent(classId) {
      return isSignedIn() && !isTeacher(classId) && (
        (firestore.exists(/databases/(default)/documents/classes/$(classId)/classStudents/$(request.auth.uid)) &&
         firestore.get(/databases/(default)/documents/classes/$(classId)/classStudents/$(request.auth.uid)).data.status == 'active') ||
        (firestore.exists(/databases/(default)/documents/classes/$(classId)/students/$(request.auth.uid)) &&
         (firestore.get(/databases/(default)/documents/classes/$(classId)/students/$(request.auth.uid)).data.status == 'active' ||
          firestore.get(/databases/(default)/documents/classes/$(classId)/students/$(request.auth.uid)).data.role == 'student')) ||
        (firestore.exists(/databases/(default)/documents/attendanceClasses/$(classId)/classStudents/$(request.auth.uid)) &&
         firestore.get(/databases/(default)/documents/attendanceClasses/$(classId)/classStudents/$(request.auth.uid)).data.status == 'active') ||
        (firestore.exists(/databases/(default)/documents/attendanceClasses/$(classId)/students/$(request.auth.uid)) &&
         (firestore.get(/databases/(default)/documents/attendanceClasses/$(classId)/students/$(request.auth.uid)).data.status == 'active' ||
          firestore.get(/databases/(default)/documents/attendanceClasses/$(classId)/students/$(request.auth.uid)).data.role == 'student'))
      );
    }

    function isSafeClassFile() {
      return request.resource != null &&
        request.resource.size < 25 * 1024 * 1024 && request.resource.contentType.matches('^(application/pdf|application/(msword|vnd.openxmlformats-officedocument.wordprocessingml.document|vnd.ms-excel|vnd.openxmlformats-officedocument.spreadsheetml.sheet)|image/(png|jpeg|webp)|video/(mp4|webm))$');
    }

    function isSafeAlphaSchoolFile() {
      return request.resource != null &&
        request.resource.size < 50 * 1024 * 1024 &&
        request.resource.contentType.matches('^(application/pdf|application/(msword|vnd.openxmlformats-officedocument.wordprocessingml.document|vnd.ms-excel|vnd.openxmlformats-officedocument.spreadsheetml.sheet|vnd.ms-powerpoint|vnd.openxmlformats-officedocument.presentationml.presentation)|image/(png|jpeg|webp|gif)|video/(mp4|webm|quicktime)|text/plain)$');
    }

    function isAlphaUser() {
      return isSignedIn() &&
        firestore.exists(/databases/(default)/documents/schools/alpha/users/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/schools/alpha/users/$(request.auth.uid)).data.get('status', 'active') == 'active';
    }

    function alphaRole() {
      return isAlphaUser()
        ? firestore.get(/databases/(default)/documents/schools/alpha/users/$(request.auth.uid)).data.role
        : '';
    }

    function isAlphaSchoolStaff() {
      return isSuperAdmin() || (isAlphaUser() && alphaRole() in ['schoolAdmin', 'admin', 'teacher']);
    }

    function isAlphaClassStudent(classId) {
      return isAlphaUser() &&
        alphaRole() == 'student' &&
        firestore.exists(/databases/(default)/documents/schools/alpha/users/$(request.auth.uid)) &&
        (
          firestore.get(/databases/(default)/documents/schools/alpha/users/$(request.auth.uid)).data.get('classId', '') == classId ||
          classId in firestore.get(/databases/(default)/documents/schools/alpha/users/$(request.auth.uid)).data.get('classIds', []) ||
          classId in firestore.get(/databases/(default)/documents/schools/alpha/users/$(request.auth.uid)).data.get('assignedClassIds', [])
        );
    }

    function canReadAlphaClassFile(classId) {
      return isAlphaSchoolStaff() || isAlphaClassStudent(classId);
    }

    function canReadAlphaQuizAttachment(quizId) {
      return isAlphaSchoolStaff() ||
        (
          firestore.exists(/databases/(default)/documents/schools/alpha/quizzes/$(quizId)) &&
          isAlphaClassStudent(firestore.get(/databases/(default)/documents/schools/alpha/quizzes/$(quizId)).data.classId)
        );
    }

    function isAllowedAdminUpload() {
      return request.resource != null &&
        request.resource.size <= 25 * 1024 * 1024 &&
        request.resource.contentType in [
          "image/png",
          "image/jpeg",
          "image/webp",
          "image/gif",
          "application/pdf"
        ];
    }

    // ── CLASSROOM ──────────────────────────────────────────
    match /schools/alpha/quizzes/{quizId}/attachments/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isSafeAlphaSchoolFile();
      allow delete: if isSignedIn();
    }

    match /alpha/{collectionName}/{classId}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() &&
        collectionName in ['assignments', 'notes', 'resources', 'quizzes', 'announcements'] &&
        isSafeAlphaSchoolFile();
      allow delete: if isSignedIn();
    }

    match /alpha/{classId}/{collectionName}/{fileName} {
      allow read: if canReadAlphaClassFile(classId);
      allow create, update: if isAlphaSchoolStaff() &&
        collectionName in ['assignments', 'notes', 'resources', 'quizzes', 'announcements'] &&
        isSafeAlphaSchoolFile();
      allow delete: if isAlphaSchoolStaff();
    }

    match /alpha/{classId}/submissions/{studentUid}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() &&
        request.auth.uid == studentUid &&
        isSafeAlphaSchoolFile();
      allow delete: if isSignedIn() && request.auth.uid == studentUid;
    }

    match /alpha/website/{section}/{fileName} {
      allow read: if true;
      allow create, update: if isSignedIn() &&
        request.resource != null &&
        request.resource.size < 15 * 1024 * 1024 &&
        request.resource.contentType.matches('^image/(png|jpeg|webp|gif)$');
      allow delete: if isSignedIn();
    }

    match /classroom/{mode}/{classId}/{fileName} {
      allow read: if isTeacher(classId) || isStudent(classId);
      allow create, update: if isSignedIn() && (
        isTeacher(classId) || 
        (mode == 'submissions' && isStudent(classId))
      ) && isSafeClassFile();
      allow delete: if isTeacher(classId) || (mode == 'submissions' && isSignedIn());
    }

    match /classrooms/{classId}/assignments/{fileName} {
      allow read: if isTeacher(classId) || isStudent(classId);
      allow create, update, delete: if isTeacher(classId) && isSafeClassFile();
    }
    match /classrooms/{classId}/resources/{fileName} {
      allow read: if isTeacher(classId) || isStudent(classId);
      allow create, update, delete: if isTeacher(classId) && isSafeClassFile();
    }
    match /classrooms/{classId}/submissions/{studentUserId}/{fileName} {
      allow read: if isTeacher(classId) || (isSignedIn() && request.auth.uid == studentUserId);
      allow create, update: if isSignedIn() && request.auth.uid == studentUserId && isStudent(classId) && isSafeClassFile();
      allow delete: if isTeacher(classId) || (isSignedIn() && request.auth.uid == studentUserId);
    }
    match /classAssignments/{classId}/{assignmentId}/materials/{fileName} {
      allow read: if isTeacher(classId) || isStudent(classId);
      allow create, update, delete: if isTeacher(classId) && isSafeClassFile();
    }

    match /classResources/{classId}/{resourceId}/{fileName} {
      allow read: if isTeacher(classId) || isStudent(classId);
      allow create, update, delete: if isTeacher(classId) && isSafeClassFile();
    }

    match /classAssignments/{classId}/{assignmentId}/submissions/{studentUserId}/{fileName} {
      allow read: if isTeacher(classId) || (isStudent(classId) && request.auth.uid == studentUserId);
      allow create, update: if isSignedIn() && request.auth.uid == studentUserId && isStudent(classId) && isSafeClassFile();
      allow delete: if isTeacher(classId) || (isSignedIn() && request.auth.uid == studentUserId && isStudent(classId));
    }

    match /classes/{classId}/assignments/{assignmentId}/teacher-files/{fileName} {
      allow read: if isTeacher(classId) || isStudent(classId);
      allow create, update: if isTeacher(classId) && isSafeClassFile();
      allow delete: if isTeacher(classId);
    }

    match /classes/{classId}/assignments/{assignmentId}/submissions/{studentUserId}/{fileName} {
      allow read: if isTeacher(classId) || (isSignedIn() && request.auth.uid == studentUserId);
      allow create, update: if isSignedIn() &&
        (isSuperAdmin() || (request.auth.uid == studentUserId && isStudent(classId))) &&
        isSafeClassFile();
      allow delete: if isTeacher(classId) || (isSignedIn() && request.auth.uid == studentUserId);
    }

    match /attendanceClasses/{classId}/assignments/{assignmentId}/teacher-files/{fileName} {
      allow read: if isTeacher(classId) || isStudent(classId);
      allow create, update: if isTeacher(classId) && isSafeClassFile();
      allow delete: if isTeacher(classId);
    }

    match /classes/{classId}/resources/{fileName} {
      allow read: if isTeacher(classId) || isStudent(classId);
      allow create, update, delete: if isTeacher(classId) && isSafeClassFile();
    }

    match /classes/{classId}/quizzes/{quizId}/teacher-files/{fileName} {
      allow read: if isTeacher(classId) || isStudent(classId);
      allow create, update, delete: if isTeacher(classId) && isSafeClassFile();
    }

    match /attendanceClasses/{classId}/assignments/{assignmentId}/submissions/{studentUserId}/{fileName} {
      allow read: if isTeacher(classId) || (isSignedIn() && request.auth.uid == studentUserId);
      allow create, update: if isSignedIn() &&
        (isSuperAdmin() || request.auth.uid == studentUserId) &&
        isSafeClassFile();
      allow delete: if isTeacher(classId) || (isSignedIn() && request.auth.uid == studentUserId);
    }

    // ── PUBLIC UPLOADS ──────────────────────────────────────
    match /uploads/{fileName} { allow read: if true; allow write: if isSuperAdmin(); }
    match /uploads/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if isAdminUploader() && request.auth.uid == userId && isAllowedAdminUpload();
      allow delete: if isAdminUploader() && request.auth.uid == userId;
    }
    match /resources/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if isSignedIn() && request.auth.uid == userId && isAllowedAdminUpload();
      allow delete: if isSignedIn() && (isAdminUploader() || request.auth.uid == userId);
    }
    match /tips-resources/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if isAdminUploader() && request.auth.uid == userId && isAllowedAdminUpload();
      allow delete: if isAdminUploader() && request.auth.uid == userId;
    }
    match /posts/{fileName} { allow read: if true; allow write: if isSuperAdmin(); }
    match /paymentMethods/{allPaths=**} { allow read: if true; allow write: if isSuperAdmin(); }
    match /websites/{fileName} {
      allow read: if true;
      allow create, update: if isAdminUploader() && isAllowedAdminUpload();
      allow delete: if isAdminUploader();
    }

    // ── USER PROFILE ────────────────────────────────────────
    match /profilePictures/{userId}/{fileName} {
      allow read: if true; 
      allow create, update: if isSignedIn() && (isSuperAdmin() || request.auth.uid == userId) && request.resource.size < 5 * 1024 * 1024;
      allow delete: if isSignedIn() && (isSuperAdmin() || request.auth.uid == userId);
    }

    match /profileCovers/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if isSignedIn() &&
        (isSuperAdmin() || request.auth.uid == userId) &&
        request.resource.size <= 10 * 1024 * 1024 &&
        request.resource.contentType in [
          "image/png",
          "image/jpeg",
          "image/webp",
          "image/gif"
        ];
      allow delete: if isSignedIn() && (isSuperAdmin() || request.auth.uid == userId);
    }

    // ── ORDERS ──────────────────────────────────────────────
    match /order_attachments/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.resource.size < 10 * 1024 * 1024;
    }

    match /toolSubscriptions/paymentProofs/{userId}/{fileName} {
      allow read: if isSuperAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow create, update: if isSignedIn() &&
        request.auth.uid == userId &&
        request.resource.size <= 25 * 1024 * 1024 &&
        request.resource.contentType in [
          "image/png",
          "image/jpeg",
          "image/webp",
          "image/gif",
          "application/pdf"
        ];
      allow delete: if isSuperAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    // ── DEFAULT DENY ────────────────────────────────────────
    match /{allPaths=**} {
      allow read: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }
  }
}
